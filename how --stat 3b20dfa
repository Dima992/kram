          const alt = (media.alt || '').trim()
          const base = (media.filename || '').replace(/\.[^.]+$/, '')
          const isPlaceholder = alt === '' || alt === media.filename || alt === base
          if (!isPlaceholder) return doc

          await req.payload.update({

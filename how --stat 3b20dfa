            doc.image && typeof doc.image === 'object' ? doc.image.id : doc.image
          if (!imageId) return doc

          const media = await req.payload.findByID({
            collection: 'media',
            id: imageId,
            locale: 'uk',
            depth: 0,
            fallbackLocale: false,
